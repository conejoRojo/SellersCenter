# =============================================
# SellersCenter — Entorno de DESARROLLO local
# Valores configurados para Docker Compose
# =============================================

# --- Django ---
SECRET_KEY="django-insecure-sc-dev-k7x!9m#p2qw@n8v$3tz&r6uj*yle5aob1cdhf4gis0"
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# --- Base de datos ---
# DB_HOST se sobreescribe a "db" por docker-compose para los contenedores
# DB_PORT: desde el host (DBeaver/pgAdmin) usar 5433; dentro de Docker sigue siendo 5432
DB_NAME=sellerscenter_dev
DB_USER=sc_user
DB_PASSWORD=sc_password
DB_HOST=localhost
DB_PORT=5433

# --- Redis ---
# REDIS_URL se sobreescribe en docker-compose para los contenedores
REDIS_URL=redis://localhost:6380/0

# --- AWS (no requerido en desarrollo local) ---
AWS_ACCESS_KEY_ID=dev-placeholder
AWS_SECRET_ACCESS_KEY=dev-placeholder
AWS_DEFAULT_REGION=us-east-1
AWS_ACCOUNT_ID=000000000000

# --- S3 (LocalStack en dev) ---
S3_MEDIA_BUCKET=sellerscenter-local-media

# --- RDS Secrets Manager (solo producción) ---
DB_SECRET_NAME=sellerscenter/prod/db

# --- Email ---
DEFAULT_FROM_EMAIL=no-reply@sellerscenter.local

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000

# --- Marketplaces (vacíos en dev, se configuran por seller) ---
MERCADOLIBRE_APP_ID=
MERCADOLIBRE_CLIENT_SECRET=
AMAZON_MARKETPLACE_ID=
SHOPIFY_API_KEY=
