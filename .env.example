# =============================================
# SellersCenter — Variables de entorno
# Copiar como .env y completar valores reales
# NUNCA commitear .env al repositorio
# =============================================

# --- Django ---
SECRET_KEY=cambia-esto-por-una-clave-segura-generada
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Base de datos (local con Docker) ---
DB_NAME=sellerscenter_dev
DB_USER=sc_user
DB_PASSWORD=sc_password
DB_HOST=localhost
DB_PORT=5432

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- AWS (para producción) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_ACCOUNT_ID=

# --- S3 ---
S3_MEDIA_BUCKET=sellerscenter-prod-media

# --- RDS (producción, via Secrets Manager) ---
DB_SECRET_NAME=sellerscenter/prod/db

# --- Email ---
DEFAULT_FROM_EMAIL=no-reply@sellerscenter.com

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Marketplaces (credenciales de integración) ---
# En producción, estos van en Secrets Manager
MERCADOLIBRE_APP_ID=
MERCADOLIBRE_CLIENT_SECRET=
AMAZON_MARKETPLACE_ID=
SHOPIFY_API_KEY=
