# Ignorar todos los archivos por defecto
*

# Pero no ignorar los directorios (necesario para buscar dentro)
!*/

# No ignorar los archivos Markdown (.md)
!*.md

# Excepciones opcionales (por si necesitas el mismo .gitignore)
!.gitignore

# Excluir específicamente carpetas que no queremos que Git recorra (optimización)
node_modules/
venv/
.venv/
env/
__pycache__/
.git/
.pytest_cache/
